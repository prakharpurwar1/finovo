# ==============================================================================
# Finovo Supabase Configuration
# ==============================================================================
# Copy this file to '.env' and populate with your project credentials:
#   cp .env.example .env
#
# Obtain these credentials from your Supabase Dashboard:
#   Project -> Project Settings -> API -> Project URL & Project API Keys
#
# CRITICAL SECURITY NOTICE:
# - ONLY use the publishable / 'anon' key (public) in client-side applications.
# - NEVER provide the 'service_role' secret or database connection password here!
# - Real '.env' files are ignored by Git (.gitignore). Never commit real secrets.
# ==============================================================================

# Supabase Project URL (format: https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anonymous Key (safe for browser distribution)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ==============================================================================
# Phase 5B: Server-Side AI Transaction Categorisation (Google Gemini)
# ==============================================================================
# SECURITY REQUIREMENTS:
# - GEMINI_API_KEY is a SERVER-SIDE SECRET only.
# - DO NOT prefix GEMINI_API_KEY with 'VITE_'.
# - The client bundle will NOT package this secret; only the server/API runtime reads it.
# - On Vercel: Add GEMINI_API_KEY in Project Settings -> Environment Variables.
# - When GEMINI_API_KEY is not set, Finovo defaults seamlessly to rule-based categorisation.
# ==============================================================================

# Google Gemini Developer API Key (Server-only secret)
GEMINI_API_KEY=AIzaSyYourSecretGeminiApiKeyHere

# Gemini Model Identifier (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

